# TortleTech Webull MCP — copy to .env and fill locally. Never commit secrets.

# mock (default, CI-safe) | live (official Webull OpenAPI SDK)
WEBULL_BACKEND=mock

# Safety — keep dry-run on until you have verified live credentials.
WEBULL_DRY_RUN=true
# When live: sandbox uses api.sandbox.webull.com; prod uses api.webull.com
WEBULL_PAPER=true
# place/replace/cancel require confirm=true on the tool call when this is true
WEBULL_CONFIRM_REQUIRED=true
# Reject orders whose estimated notional exceeds this USD cap (options use x100 multiplier)
WEBULL_MAX_NOTIONAL_USD=500

# Official OpenAPI credentials from https://www.webull.com/center#openApiManagement
# Required only when WEBULL_BACKEND=live. Leave blank in mock mode.
WEBULL_APP_KEY=
WEBULL_APP_SECRET=
WEBULL_ACCOUNT_ID=
WEBULL_REGION_ID=us
# sandbox | prod  (paper=true forces sandbox even if this says prod)
WEBULL_ENVIRONMENT=sandbox

# Optional: directory for the official SDK 2FA token file (never log this path's contents)
# WEBULL_OPENAPI_TOKEN_DIR=
